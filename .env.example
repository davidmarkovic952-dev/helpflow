# Aplikaciona uloga (bez BYPASSRLS) — nikad superuser
DATABASE_URL=postgres://helpflow_app:CHANGE_ME@localhost:5432/helpflow
# Vlasnik šeme — koristi se SAMO za migracije (npm run migrate -w server)
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/helpflow
APP_DB_PASSWORD=CHANGE_ME
# 32 nasumična bajta: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
APP_ORIGIN=https://support.example.com
COOKIE_SECURE=true
# Broj reverse proxy-ja ispred aplikacije (npr. 1 za Nginx/Render)
TRUST_PROXY=1
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# rules | gemini | anthropic
AI_PROVIDER=rules
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Provera lozinki u bazi procurelih (k-anonimnost, šalje se samo 5 znakova SHA-1 heša)
HIBP_CHECK=true
